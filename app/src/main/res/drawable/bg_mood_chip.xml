<?xml version="1.0" encoding="utf-8"?>
<!--
    Pill background for mood chips.
    Fill: @color/mood_chip_fill (slightly lighter than app background)
    Stroke: app accent colour at ~60% opacity
    Corner radius: 18dp (fully rounded at 36dp chip height)
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/mood_chip_fill" />

    <stroke
        android:width="1dp"
        android:color="@color/accent_stroke" />

    <corners android:radius="18dp" />

</shape>
